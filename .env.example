# ─── Required ──────────────────────────────────────────────────────────────

# PostgreSQL connection string. Local dev via the embedded DB helper uses:
#   postgresql://postgres:postgres@localhost:5432/focus?schema=public
# Production (Neon): copy the "Pooled connection" string from the Neon dashboard
# and append ?sslmode=require if it isn't already present.
# For Supabase, use the SESSION pooler (port 5432), NOT the transaction pooler
# (6543): this is a long-running server and Prisma interactive transactions
# (enrollment, advanceStep) fail with P2028 over the transaction pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focus?schema=public"

# Secret used to sign session JWTs. Must be at least 16 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-16-chars"

# The app's public base URL. Used to build signed file-download links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Storage ───────────────────────────────────────────────────────────────

# "local" writes uploads to disk (dev only). "r2" uses Cloudflare R2 (production).
STORAGE_DRIVER="local"

# Only used when STORAGE_DRIVER=local.
LOCAL_STORAGE_PATH="./storage"

# Required only when STORAGE_DRIVER=r2 (Cloudflare R2 — S3-compatible).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional: public bucket URL, if you serve materials from a public R2 domain.
R2_PUBLIC_URL=""

# ─── Observability & rate limiting (optional, SPEC.md §11) ───────────────────

# Log level: debug | info | warn | error | silent. Default "info".
LOG_LEVEL="info"

# Override the auth rate-limit thresholds (attempts per window). Defaults:
# login 5 / 15 min, register 10 / 60 min. Handy for staging/tests.
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_REGISTER_MAX="10"

# ─── Production bootstrap (prisma/seed-production.ts only) ───────────────────
# Only needed when running `npm run seed:production` to create the first
# teacher account. Not read by the app at runtime.
TEACHER_NAME="Անուն Ազգանուն"
TEACHER_EMAIL="teacher@example.com"
TEACHER_PASSWORD="change-me-at-least-8-chars"

# --- Direct DB connection for Prisma migrations (Supabase; SPEC §14) ---
# Session pooler (port 5432) or direct connection. Only needed for migrate/db push.
DIRECT_URL=""

# --- AI Knowledge Base (SPEC §14) ---
# Roadmap generation (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Embeddings (OpenAI text-embedding-3-small): https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional overrides:
EMBEDDING_MODEL="text-embedding-3-small"
ROADMAP_MODEL="claude-opus-5"
